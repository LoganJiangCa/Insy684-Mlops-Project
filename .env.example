# Copy to .env, choose a local password, and do not commit .env.
POSTGRES_USER=mlops
POSTGRES_DB=mlops
POSTGRES_PASSWORD=replace-with-your-local-password
# Use postgres inside Compose; use localhost if running the API outside Compose.
DATABASE_URL=postgresql+psycopg://mlops:replace-with-your-local-password@postgres:5432/mlops
# Must point to the SAME registry and accessible artifacts as the training flow.
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=digits-decision-tree
MODEL_VERSION=1
# Exact frontend origins, comma separated. Empty disables cross-origin requests.
CORS_ORIGINS=http://localhost:8080
